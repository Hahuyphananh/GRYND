# GRYND — environment template (VERCEL side)
#
# Copy to `.env.local` for local development:  cp .env.example .env.local
# This file is a template for the variables the SPLIT DEPLOYMENT needs
# (browser → Vercel, and Vercel → Render realtime). It is NOT the complete list
# of GRYND's environment — see docs/PROD_REALTIME_AND_NEON_TASKS.md and
# docs/LAUNCH_CHECKLIST.md for the rest.
#
# Deployed side: VERCEL. Set these in Project Settings → Environment Variables.
# `NEXT_PUBLIC_*` values are inlined into the browser bundle at BUILD time, so
# changing one requires a redeploy.
#
# This file must stay VALUE-FREE. No real keys, tokens, hashes or connection
# strings. tests/speed-typing-deployment.test.mjs enforces that.

# ── Browser → Render (public, inlined into the bundle) ──────────────────

# The public https URL of the standalone Socket.IO service (Render).
# This is the ONLY realtime value the browser ever sees.
NEXT_PUBLIC_SOCKET_URL=https://your-realtime-service.onrender.com

# ── Vercel → Render (server-only) ───────────────────────────────────────

# Server-to-server base URL of the SAME realtime service, used by the backend
# to push into socket rooms (the `/emit` relay) in the split-process deployment.
# Falls back to NEXT_PUBLIC_SOCKET_URL when unset, which works but couples the
# internal hop to the public hostname.
REALTIME_INTERNAL_URL=https://your-realtime-service.onrender.com

# Shared secret authenticating those calls. MUST match the value set on Render.
# If it is missing, the relay is simply skipped (a missed push costs one poll);
# if it MISmatches, Render answers 401 and every push is silently lost.
REALTIME_INTERNAL_SECRET=your_shared_internal_secret_here

# ── Authentication (Clerk) ──────────────────────────────────────────────

# Publishable key — public by design, present in the browser bundle.
# (Paste the real `pk_...` value locally; templates stay placeholder-only.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Secret key — server only. Also re-verifies the socket's session token in the
# disconnect-forfeit routes. Must be set on BOTH Vercel and Render.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ── Database ────────────────────────────────────────────────────────────

# Postgres connection string (Neon), shaped like
#   postgres://<user>:<password>@<host>/<database>?sslmode=require
# Create `.env.local`, not `.env`.
DATABASE_URL=your_neon_connection_string_here

# PEM root CA that verifies the database server's certificate. REQUIRED for any
# non-local host: without it the app refuses to open the connection rather than
# connect unverified. Download the bundle from your provider (Supabase:
# Project Settings -> Database -> SSL Configuration) and set its path here.
# Production reads /home/ubuntu/grynd/env/db-ca.pem via grynd/env/app.env.
# Not needed for localhost, where the pool connects without TLS.
# See docs/SUPABASE_MIGRATION.md -> "Verifying the database certificate".
DATABASE_SSL_CA_PATH=

# ── Admin second factor (self-hosted MFA) ───────────────────────────────
# GRYND does not use Clerk's paid MFA. The admin gate is a signed, HttpOnly
# cookie issued after one of three factors. A factor whose variable is unset is
# simply UNAVAILABLE — after moving hosts, check these first. If every factor is
# unset, admin access is refused and /admin/mfa-required says why.

# Signs the admin_mfa / user_mfa cookie. Changing it invalidates existing MFA
# cookies (users re-verify once); missing it falls back to CLERK_SECRET_KEY,
# and with neither the cookie is signed with a hard-coded development value.
GAME_SESSION_SECRET=your_random_session_secret_here

# Passphrase factor.
ADMIN_MFA_PASSPHRASE=your_admin_passphrase_here

# Authenticator (TOTP) factor: base32, shared by every admin.
ADMIN_TOTP_SECRET=your_base32_totp_secret_here

# Comma-separated Clerk user ids treated as admins without a DB lookup.
# The users.is_admin column remains the primary source of truth.
CHAT_ADMIN_CLERK_IDS=your_clerk_user_id_1,your_clerk_user_id_2

# ── Email delivery (admin codes and transactional mail) ─────────────────
# EITHER a Resend key OR an SMTP host is required. With neither, email codes
# cannot be sent and the MFA page reports that factor as unavailable.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=no-reply@your-domain.example

# Optional SMTP fallback. Some hosts block outbound port 25; prefer 587.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM=no-reply@your-domain.example

# ── Email-code storage (optional, recommended) ──────────────────────────
# Without Redis, one-time codes live in a single process's memory: a restart
# or a second app instance invalidates the code between sending and verifying.
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ── Operations dashboard (Admin → Operations) ───────────────────────────
# Release root written by deploy/. The dashboard reads ONLY state/ (deployments,
# audit, backup ledger) and never env/.
GRYND_RELEASE_ROOT=/home/ubuntu/grynd

# ── Coin shop (/rewards → CoinShopOffers) ──────────────────────────────
# Opt-in server flag for the one-time coin packs. Only the exact value "1"
# enables them; unset (or any other value) makes GET /api/coins/packages answer
# `enabled: false` with an empty offer list, and the rewards page then renders
# NO shop surface at all — not an empty card, no placeholder. This is a RUNTIME
# variable read per request, so it belongs in the deployed environment (Vercel
# project env, or /home/ubuntu/grynd/env/app.env on the release host) and needs
# no rebuild. The launch catalog resolves from the `token_packages` rows
# `starter`, `medium` and `large` (see src/lib/coinPurchases.ts).
# COIN_PURCHASES_ENABLED=1

# ── Post-match video ad (HilltopAds VAST) ──────────────────────────────
# Optional, dismissible video shown ONLY after a finished PvP match, and only
# when that match's result screen offers it. The approved tag and the frequency
# policy (one offer per match, one per tab session, 5-minute cooldown) are
# built-in defaults, so an unedited environment needs none of these.
# NEXT_PUBLIC_HILLTOPS_VAST_URL=https://your-vast-endpoint.example/tag.xml
# Provider switch and master kill switch — either one set to false turns the
# whole post-match surface off (no card, no request).
# NEXT_PUBLIC_HILLTOPS_ENABLED=true
# NEXT_PUBLIC_POST_MATCH_ADS_ENABLED=true
# Server-side kill switch, read per request — no rebuild needed. Setting this to
# false stops post-match advertising on the next request.
# POST_MATCH_ADS_ENABLED=true
# Delivery cadence: one offer per N completed matches, and a minimum gap after
# the previous offer or dismissal. Defaults are 3 matches and 5 minutes.
# NEXT_PUBLIC_POST_MATCH_AD_MATCHES_PER_OFFER=3
# NEXT_PUBLIC_POST_MATCH_AD_COOLDOWN_MINUTES=5
