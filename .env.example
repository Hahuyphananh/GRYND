# GRYND — environment template (VERCEL side)
#
# Copy to `.env.local` for local development:  cp .env.example .env.local
# This file is a template for the variables the SPLIT DEPLOYMENT needs
# (browser → Vercel, and Vercel → Render realtime). It is NOT the complete list
# of GRYND's environment — see docs/PROD_REALTIME_AND_NEON_TASKS.md and
# docs/LAUNCH_CHECKLIST.md for the rest.
#
# Deployed side: VERCEL. Set these in Project Settings → Environment Variables.
# `NEXT_PUBLIC_*` values are inlined into the browser bundle at BUILD time, so
# changing one requires a redeploy.
#
# This file must stay VALUE-FREE. No real keys, tokens, hashes or connection
# strings. tests/speed-typing-deployment.test.mjs enforces that.

# ── Browser → Render (public, inlined into the bundle) ──────────────────

# The public https URL of the standalone Socket.IO service (Render).
# This is the ONLY realtime value the browser ever sees.
NEXT_PUBLIC_SOCKET_URL=https://your-realtime-service.onrender.com

# ── Vercel → Render (server-only) ───────────────────────────────────────

# Server-to-server base URL of the SAME realtime service, used by the backend
# to push into socket rooms (the `/emit` relay) in the split-process deployment.
# Falls back to NEXT_PUBLIC_SOCKET_URL when unset, which works but couples the
# internal hop to the public hostname.
REALTIME_INTERNAL_URL=https://your-realtime-service.onrender.com

# Shared secret authenticating those calls. MUST match the value set on Render.
# If it is missing, the relay is simply skipped (a missed push costs one poll);
# if it MISmatches, Render answers 401 and every push is silently lost.
REALTIME_INTERNAL_SECRET=your_shared_internal_secret_here

# ── Authentication (Clerk) ──────────────────────────────────────────────

# Publishable key — public by design, present in the browser bundle.
# (Paste the real `pk_...` value locally; templates stay placeholder-only.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Secret key — server only. Also re-verifies the socket's session token in the
# disconnect-forfeit routes. Must be set on BOTH Vercel and Render.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ── Database ────────────────────────────────────────────────────────────

# Postgres connection string (Neon), shaped like
#   postgres://<user>:<password>@<host>/<database>?sslmode=require
# Create `.env.local`, not `.env`.
DATABASE_URL=your_neon_connection_string_here
