# GRYND — environment template (VERCEL side)
#
# Copy to `.env.local` for local development:  cp .env.example .env.local
# This file is a template for the variables the SPLIT DEPLOYMENT needs
# (browser → Vercel, and Vercel → Render realtime). It is NOT the complete list
# of GRYND's environment — see docs/PROD_REALTIME_AND_NEON_TASKS.md and
# docs/LAUNCH_CHECKLIST.md for the rest.
#
# Deployed side: VERCEL. Set these in Project Settings → Environment Variables.
# `NEXT_PUBLIC_*` values are inlined into the browser bundle at BUILD time, so
# changing one requires a redeploy.
#
# This file must stay VALUE-FREE. No real keys, tokens, hashes or connection
# strings. tests/speed-typing-deployment.test.mjs enforces that.

# ── Browser → Render (public, inlined into the bundle) ──────────────────

# The public https URL of the standalone Socket.IO service (Render).
# This is the ONLY realtime value the browser ever sees.
NEXT_PUBLIC_SOCKET_URL=https://your-realtime-service.onrender.com

# ── Vercel → Render (server-only) ───────────────────────────────────────

# Server-to-server base URL of the SAME realtime service, used by the backend
# to push into socket rooms (the `/emit` relay) in the split-process deployment.
# Falls back to NEXT_PUBLIC_SOCKET_URL when unset, which works but couples the
# internal hop to the public hostname.
REALTIME_INTERNAL_URL=https://your-realtime-service.onrender.com

# Shared secret authenticating those calls. MUST match the value set on Render.
# If it is missing, the relay is simply skipped (a missed push costs one poll);
# if it MISmatches, Render answers 401 and every push is silently lost.
REALTIME_INTERNAL_SECRET=your_shared_internal_secret_here

# ── Proxy trust ─────────────────────────────────────────────────────────
# How many proxies you control sit in front of the app. The client IP (used by
# the API rate limiter, the audit log and the admin MFA attempt counter) is
# read that many hops in from the END of X-Forwarded-For; entries further left
# are whatever the caller sent. Vercel/Render = 1. Add Cloudflare in front and
# set 2. Never 0: that trusts a header the client wrote itself.
TRUSTED_PROXY_COUNT=1

# ── Authentication (Clerk) ──────────────────────────────────────────────

# Publishable key — public by design, present in the browser bundle.
# (Paste the real `pk_...` value locally; templates stay placeholder-only.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Secret key — server only. Also re-verifies the socket's session token in the
# disconnect-forfeit routes. Must be set on BOTH Vercel and Render.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ── Database ────────────────────────────────────────────────────────────

# Postgres connection string (Neon), shaped like
#   postgres://<user>:<password>@<host>/<database>?sslmode=require
# Create `.env.local`, not `.env`.
DATABASE_URL=your_neon_connection_string_here

# OWNER connection string, used ONLY by `npm run db:migrate` (src/db/migrate.ts).
# Once DATABASE_URL points at the non-owner `app_user` role
# (docs/security-fixes/staging-app-role.sql), DDL needs the owner here. Leave
# unset and migrations fall back to DATABASE_URL, i.e. they run as the app role
# and fail closed.
MIGRATION_DATABASE_URL=your_owner_connection_string_here

# PEM root CA that verifies the database server's certificate. REQUIRED for any
# non-local host: without it the app refuses to open the connection rather than
# connect unverified. Download the bundle from your provider (Supabase:
# Project Settings -> Database -> SSL Configuration) and set its path here.
# Production reads /home/ubuntu/grynd/env/db-ca.pem via grynd/env/app.env.
# Not needed for localhost, where the pool connects without TLS.
# See docs/SUPABASE_MIGRATION.md -> "Verifying the database certificate".
DATABASE_SSL_CA_PATH=

# ── Age gate (18+) ──────────────────────────────────────────────────────
# The gate is ENFORCED by default: a signed-in account whose recorded age is
# under 18 is redirected to /access-denied by the proxy, and every game /
# wagering API refuses it (src/lib/auth/requireAgeVerified.ts).
#
#   enforce (default, and what any unrecognised value means)
#   log     shadow mode — reports what WOULD be rejected, blocks nobody
#   off     skips the age check (authentication is never affected)
# Use "log" for a measured rollout; use "off" only as a deliberate emergency
# lever, never as steady state.
API_AGE_GATE=enforce

# Accounts created before this instant predate age collection and are exempt
# from the gate (in-flight sessions, not a way to avoid collecting a DOB).
# Set to "off" once the legacy population has completed /complete-profile, so
# the 18+ rule applies to every account without exception.
LEGACY_AGE_GATE_CUTOFF=2026-09-19T00:00:00.000Z

# ── Admin second factor (self-hosted MFA) ───────────────────────────────
# GRYND does not use Clerk's paid MFA. The admin gate is a signed, HttpOnly
# cookie issued after one of three factors. A factor whose variable is unset is
# simply UNAVAILABLE — after moving hosts, check these first. If every factor is
# unset, admin access is refused and /admin/mfa-required says why.

# Signs the admin_mfa / user_mfa cookie. Changing it invalidates existing MFA
# cookies (users re-verify once); missing it falls back to CLERK_SECRET_KEY.
# With neither, a DEVELOPMENT run signs with a hard-coded value (and warns),
# while a PRODUCTION process refuses to start — that fallback is public
# source, so it would let anyone forge an admin step-up cookie.
GAME_SESSION_SECRET=your_random_session_secret_here

# Passphrase factor.
ADMIN_MFA_PASSPHRASE=your_admin_passphrase_here

# Authenticator (TOTP) factor: base32, shared by every admin.
ADMIN_TOTP_SECRET=your_base32_totp_secret_here

# Comma-separated Clerk user ids treated as admins without a DB lookup.
# The users.is_admin column remains the primary source of truth.
CHAT_ADMIN_CLERK_IDS=your_clerk_user_id_1,your_clerk_user_id_2

# ── Deploy from the admin dashboard ─────────────────────────────────────
# Fine-grained GitHub token used only by /admin/operations to dispatch the
# release workflow (the same one a push to main uses). Needs Actions: write and
# Contents: read on this repository. Without it the Deploy button reports "not
# configured"; nothing else on the dashboard changes.
GITHUB_DEPLOY_TOKEN=github_pat_your_token_here
# The repository the release workflow lives in, owner/name.
GITHUB_DEPLOY_REPO=Hahuyphananh/GRYND

# ── Email delivery (admin codes and transactional mail) ─────────────────
# EITHER a Resend key OR an SMTP host is required. With neither, email codes
# cannot be sent and the MFA page reports that factor as unavailable.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=no-reply@your-domain.example

# Optional SMTP fallback. Some hosts block outbound port 25; prefer 587.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM=no-reply@your-domain.example

# ── Email-code storage (optional, recommended) ──────────────────────────
# Without Redis, one-time codes live in a single process's memory: a restart
# or a second app instance invalidates the code between sending and verifying.
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ── Operations dashboard (Admin → Operations) ───────────────────────────
# Release root written by deploy/. The dashboard reads ONLY state/ (deployments,
# audit, backup ledger) and never env/.
GRYND_RELEASE_ROOT=/home/ubuntu/grynd

# ── Post-match video ad (HilltopAds VAST) ──────────────────────────────
# Full-page video that plays AUTOMATICALLY after a finished match — PvP and
# vs-AI alike — over the result screen. A creative longer than 15 seconds shows
# a skip control at 15 s (shorter ones unlock it at their own end); loading and
# failure states are always closeable. The approved tag and the cadence (every
# finished match, at most once per match id) are built-in defaults, so an
# unedited environment needs none of these.
# NEXT_PUBLIC_HILLTOPS_VAST_URL=https://your-vast-endpoint.example/tag.xml
# Provider switch and master kill switch — either one set to false turns the
# whole post-match surface off (no card, no request).
# NEXT_PUBLIC_HILLTOPS_ENABLED=true
# NEXT_PUBLIC_POST_MATCH_ADS_ENABLED=true
# Consent gate. Defaults to true: no VAST tag is requested until the shared
# consent record says "accepted". Only set false with a documented legal basis.
# NEXT_PUBLIC_POST_MATCH_ADS_REQUIRES_CONSENT=true
# Server-side kill switch, read per request — no rebuild needed. Setting this to
# false stops post-match advertising on the next request.
# POST_MATCH_ADS_ENABLED=true
# Delivery cadence, if the shipped default (an offer after every finished match,
# once per match id) is too heavy: one offer per N completed matches, and a
# minimum gap after the previous offer or dismissal. Defaults: 1 match, 0 minutes.
# NEXT_PUBLIC_POST_MATCH_AD_MATCHES_PER_OFFER=3
# NEXT_PUBLIC_POST_MATCH_AD_COOLDOWN_MINUTES=5

# ── Ad fallback priority (Phase 5) ─────────────────────────────────────
# Comma-separated, highest priority first. Unknown names are ignored and an
# empty list falls back to hilltop,exoclick,adcash. Listing a provider here
# does NOT enable it: its own switch + zone/tag are still required.
# NEXT_PUBLIC_ADS_BANNER_ORDER=hilltop,exoclick,adcash
# NEXT_PUBLIC_ADS_VIDEO_ORDER=hilltop,exoclick,adcash
#
# Bounded waits for the sequential banner chain (milliseconds). The per-provider
# deadline is clamped 1500–8000; the whole-chain budget 2000–15000.
# NEXT_PUBLIC_ADS_BANNER_PROVIDER_TIMEOUT_MS=3500
# NEXT_PUBLIC_ADS_BANNER_BUDGET_MS=8000
# The post-match video chain shares one budget, clamped 2000–12000.
# NEXT_PUBLIC_ADS_VIDEO_BUDGET_MS=6000

# ── CSP allowlists for account-specific ad hosts ──────────────────────
# The CSP already names every code-known provider host exactly (no generic
# `https:`, no provider wildcard). A provider's creative/measurement CDN and a
# VAST MediaFile's redirect CDN are account-specific, so they are NOT guessed.
# Add the exact HTTPS origins the publisher dashboard reports, comma separated:
#
#   ADS_CREATIVE_HOSTS=https://cdn.provider.example,https://track.provider.example
#   ADS_MEDIA_HOSTS=https://media.provider.example
#
# These are SERVER runtime values: the policy is built per request, so changing
# them needs a restart but not a rebuild. Entries must be bare origins (no path,
# query, credentials or wildcard); invalid entries are ignored. An unlisted host
# is blocked and the ad fails closed.
# ADS_CREATIVE_HOSTS=
# ADS_MEDIA_HOSTS=

# ── Post-match video — ExoClick and Adcash VAST ───────────────────────
# Additional VAST providers for the SAME post-match player. Both are DISABLED
# by default and have NO default tag: copy the video zone's VAST tag from each
# publisher dashboard. A tag must return VAST Inline (not Wrapper) — see
# docs/vast-providers.md for the preflight check. Do not use a floating Video
# Slider zone.
#
#   NEXT_PUBLIC_EXOCLICK_VAST_ENABLED=true
#   NEXT_PUBLIC_EXOCLICK_VAST_TAG=https://<exoclick-vast-tag>
#   NEXT_PUBLIC_ADCASH_VAST_ENABLED=true
#   NEXT_PUBLIC_ADCASH_VAST_TAG=https://<adcash-vast-tag>
#
# Optional per-provider request deadlines (milliseconds, 1000–8000, default
# 4000). The global kill switch NEXT_PUBLIC_POST_MATCH_ADS_ENABLED=false still
# disables every provider.
# NEXT_PUBLIC_EXOCLICK_VAST_TIMEOUT_MS=4000
# NEXT_PUBLIC_ADCASH_VAST_TIMEOUT_MS=4000
# NEXT_PUBLIC_HILLTOPS_VAST_TIMEOUT_MS=4000

# ── HilltopAds banner (src/lib/hilltop/config.ts) ──────────────────────
# A third, INDEPENDENT provider. It does not read the AdSense or VAST flags,
# and turning it off leaves both of them untouched.
#
# DISABLED BY DEFAULT — every switch is opt-in ("true" or "1"):
#
#   NEXT_PUBLIC_HILLTOP_BANNER_ENABLED=true   build-time switch.
#   HILLTOP_BANNER_ENABLED=true               server, read per request.
#   HILLTOP_BANNER_PROVIDER_ATTESTED=true     server. Set ONLY after HilltopAds
#                                             confirms in writing that this zone
#                                             cannot enable its fullscreen/blur
#                                             modes, cannot force a popunder or
#                                             top-window navigation from a
#                                             creative, and serves creatives in
#                                             an iframe we keep out of gameplay.
#                                             The loader creates that iframe
#                                             with no `sandbox` attribute, so
#                                             its behaviour is not ours to
#                                             restrain — this flag records that
#                                             the provider accepted the limit.
#   NEXT_PUBLIC_HILLTOP_BANNER_REQUIRES_CONSENT=true  defaults to true. No tag
#                                            is injected until the shared
#                                            consent record says "accepted".
#   NEXT_PUBLIC_HILLTOP_BANNER_SCRIPT_URL    optional override. Must be https (or
#                                            protocol-relative) on
#                                            juvenilechoice.com, with no
#                                            credentials; anything malformed
#                                            renders NO banner (fail closed).
#
# The tag loads AT MOST ONCE per browser session, only on the four approved
# routes (/ , /games , /classement , /profil — matched against the actual
# pathname, so lobbies and matches inject nothing), and never for GRYND PRO
# members. The provider exposes NO frequency control: there is no impression cap
# to configure, so none is invented here. See src/lib/hilltop/config.ts.
# NEXT_PUBLIC_HILLTOP_BANNER_ENABLED=true

# ── ExoClick banner (src/lib/exoclick/config.ts) ───────────────────────
# A banner provider INDEPENDENT of AdSense and of the HilltopAds banner. It
# reads only EXOCLICK_* values; turning it off leaves the other providers
# untouched.
#
# DISABLED BY DEFAULT. Nothing renders until BOTH switches are opted in AND a
# real zone id + the provider-generated `<ins>` class token are supplied. There
# are NO built-in zone ids or class tokens: inventing either would request
# inventory that is not ours.
#
# In the ExoClick dashboard create a BANNER zone (not sticky, push, interstitial,
# direct link, popunder or video slider) and copy the asynchronous tag from
# Your Zone HTML Tag → Asynchronous Script. It looks like:
#
#   <script async src="a.magsrv.com/ad-provider.js"></script>
#   <ins class="<ZONE_CLASS>" data-zoneid="<ZONE_ID>"></ins>
#
#   NEXT_PUBLIC_EXOCLICK_ENABLED=true          build-time switch (rebuild).
#   EXOCLICK_ENABLED=true                      server, read per request.
#   NEXT_PUBLIC_EXOCLICK_ZONE_HOME=<zone id>   numeric id, per approved page.
#   NEXT_PUBLIC_EXOCLICK_ZONE_LEADERBOARD=<zone id>
#   NEXT_PUBLIC_EXOCLICK_ZONE_PROFILE=<zone id>
#   NEXT_PUBLIC_EXOCLICK_ZONE_HUB=<zone id>    reserved; no page mounts the hub.
#   NEXT_PUBLIC_EXOCLICK_INS_CLASS=<class>     the `<ins>` class token from the
#                                              SAME zone tag. Required.
#   NEXT_PUBLIC_EXOCLICK_INS_CLASS_<PLACEMENT> optional per-placement token.
#   NEXT_PUBLIC_EXOCLICK_BANNER_SIZE=300x250   or 728x90 / responsive.
#   NEXT_PUBLIC_EXOCLICK_BANNER_SIZE_<PLACEMENT> optional per-placement size.
#   NEXT_PUBLIC_EXOCLICK_SCRIPT_URL=…          optional override. Must be https
#                                              on *.magsrv.com or *.exoclick.com.
#   NEXT_PUBLIC_EXOCLICK_REQUIRES_CONSENT=true  defaults to true. The tag is not
#                                              injected until the visitor's
#                                              stored consent says "accepted".
#
# Only conventional display banners are supported. Do not point these variables
# at a sticky/popunder/interstitial/push/direct-link zone.
#
# Zones are opened by the BROWSER, so the ids and class token are public values
# (they appear in the page source). Never put an ExoClick password, API key or
# dashboard credential in a NEXT_PUBLIC_* variable or anywhere in this repo.
# NEXT_PUBLIC_EXOCLICK_ENABLED=true
# NEXT_PUBLIC_EXOCLICK_ZONE_HOME=0000000
# NEXT_PUBLIC_EXOCLICK_INS_CLASS=your_zone_class_here

# ── Adcash display banner (src/lib/adcash/config.ts) ──────────────────
# A DISPLAY-format banner provider, independent of AdSense, HilltopAds and
# ExoClick. It reads only ADCASH_* values.
#
# ENABLED BY DEFAULT with the account library URL and Display zone below; both are
# overridable from the Adcash publisher panel. The integration
# uses the documented display call:
#
#   aclib.runBanner({ zoneId: '<ZONE_ID>', renderIn: '##<container>' })
#
# Create a DISPLAY zone (not pop-under, autotag, interstitial, in-page push or
# video slider) and copy the library snippet + zone id from the panel.
#
#   NEXT_PUBLIC_ADCASH_ENABLED=true            build-time switch (rebuild).
#   ADCASH_ENABLED=true                        server, read per request.
#   NEXT_PUBLIC_ADCASH_LIBRARY_URL=<url>       REQUIRED. The Adcash library
#                                              script URL from the panel. Must
#                                              be https on acscdn.com or
#                                              *.adcash.com.
#   NEXT_PUBLIC_ADCASH_ZONE_HOME=<zone id>     numeric display zone, per page.
#   NEXT_PUBLIC_ADCASH_ZONE_LEADERBOARD=<zone id>
#   NEXT_PUBLIC_ADCASH_ZONE_PROFILE=<zone id>
#   NEXT_PUBLIC_ADCASH_ZONE_HUB=<zone id>      reserved; no page mounts the hub.
#   NEXT_PUBLIC_ADCASH_BANNER_SIZE=300x250     or 728x90.
#   NEXT_PUBLIC_ADCASH_BANNER_SIZE_<PLACEMENT> optional per-placement size.
#   NEXT_PUBLIC_ADCASH_REQUIRES_CONSENT=true   defaults to true. The banner is
#                                              not drawn until consent is
#                                              "accepted".
#
# Do not add pop-under, autotag, interstitial, in-page push, video slider or
# anti-adblock scripts. Zone ids are public (they appear in the page source);
# never put an Adcash password or API key in a NEXT_PUBLIC_* variable.
# NEXT_PUBLIC_ADCASH_ENABLED=true
# NEXT_PUBLIC_ADCASH_LIBRARY_URL=https://acscdn.com/script/aclib.js
# NEXT_PUBLIC_ADCASH_ZONE_HOME=0000000

# ── Trustpilot (src/lib/trustpilot.ts) ─────────────────────────────────
# Ownership of the domain is proven by the one-time meta tag in the HOME PAGE's
# metadata (src/app/page.jsx), which Trustpilot reads from the served <head>.
#
# The TrustBox widget and the "Write a review" link appear on /reviews ONLY
# once BOTH ids below are set to values Trustpilot issued for this business
# unit. With either one missing or malformed nothing renders at all — no empty
# card, and no review link pointing at an unverified domain.
#
#   NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID  business unit id (Trustpilot
#                                            dashboard → Integrations).
#   NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID       template id of the TrustBox design
#                                            you configured there.
#   NEXT_PUBLIC_TRUSTPILOT_DOMAIN            optional. The domain as registered
#                                            on Trustpilot; defaults to this
#                                            site's canonical host.
#   NEXT_PUBLIC_TRUSTPILOT_ENABLED           "false" removes the whole surface
#                                            without touching any code.
#
# These are public values — they appear in the page source of every site that
# embeds a TrustBox — so they belong in NEXT_PUBLIC_* and need a rebuild.
# NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=your_business_unit_id_here
# NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID=your_template_id_here

# ── Solitaire analytics dashboard (/admin/analytics) ─────────────────────────
#   POSTHOG_PERSONAL_API_KEY   personal API key with project READ access, used
#                              server-side only by the HogQL Query API. Never
#                              expose it as NEXT_PUBLIC_*.
#   POSTHOG_PROJECT_ID         numeric project id the key belongs to.
#   POSTHOG_HOST               optional; defaults to NEXT_PUBLIC_POSTHOG_HOST,
#                              then https://us.posthog.com.
# Without the first two the dashboard renders an explanatory banner and the app
# keeps capturing events normally.
# POSTHOG_PERSONAL_API_KEY=phx_your_personal_key
# POSTHOG_PROJECT_ID=000000
#
# -- Ad rotation (default ON) -----------------------------------------
# The sequential chain stops at the first fill, so a fixed priority makes the
# first configured provider win every slot and the others pure fallbacks.
# Rotation re-orders the ELIGIBLE list by a hash of the opportunity id, so
# HilltopAds and Adcash roughly alternate across page loads, placements and
# matches. The same opportunity always yields the same order, so a remount
# cannot reorder a running chain. Set false to keep the strict priority above.
# NEXT_PUBLIC_ADS_ROTATION=true
#
# NOTE: an Adcash AUTOTAG zone id (ztXXXXXXXX) is refused as a display zone.
# Autotag rotates Pop-Under, Interstitial, In-Page Push and Video Slider, which
# this product prohibits. Use a numeric DISPLAY zone for banners and an
# in-stream video zone VAST tag for the post-match player.
#
# -- Ad earnings reporting (admin Operations page) --------------------
# Read by GET /api/admin/ad-earnings, server-side only. Never expose these
# values as NEXT_PUBLIC_*: they are account credentials.
#
# HilltopAds: My Account -> API -> generate key. The statistics API returns
# no currency, so declare the account currency as well.
# HILLTOP_REPORTING_API_KEY=
# HILLTOP_REPORTING_CURRENCY=USD
#
# ExoClick: My Profile -> API Tokens -> new token. Publisher statistics are
# rate limited to 30/min per IP; ExoClick reporting currency must be declared.
# EXOCLICK_REPORTING_API_TOKEN=
# EXOCLICK_REPORTING_CURRENCY=EUR
#
# Adcash: Statistics -> API Tokens -> enable Reporting API token. The currency
# is read from the response metadata. Override the base URL only if the panel
# gives this account a different subdomain.
# ADCASH_REPORTING_API_TOKEN=
# ADCASH_REPORTING_BASE_URL=https://adcash.myadcash.com/api/v2
#
# A provider left unset is shown as "not configured" and contributes nothing
# to any total. Totals are never converted between currencies.
#
# -- Ad Exchange post-match video (youradexchange.com) ----------------
# Video only: the tag has no display zone and is never used as a banner.
# It plays on the post-match result screen only, is skipped for GRYND PRO and
# waits for consent, exactly like the other video providers.
# Built-in tag: https://youradexchange.com/video/select.php?r=12500162
# Enabled by default; set false to remove it without touching code.
# NEXT_PUBLIC_ADEXCHANGE_VAST_ENABLED=true
# NEXT_PUBLIC_ADEXCHANGE_VAST_TAG=https://youradexchange.com/video/select.php?r=12500162
# NEXT_PUBLIC_ADEXCHANGE_VAST_TIMEOUT_MS=4000
