#!/usr/bin/env bash
# ============================================================================
# pre-commit hook: block secrets from being committed
#
# Scans staged files and content for API keys, tokens, passwords, private
# keys, and banned env/credential file names. On a match it aborts the
# commit and lists the offending file.
#
# Install for every collaborator (one-time, per clone):
#     git config core.hooksPath .githooks
#
# Deliberate bypass (use only when you know what you are doing):
#     git commit --no-verify
#
# PERFORMANCE (2025 rewrite): the first version walked the diff line by line
# and forked `grep` twice per added line. On Windows Git Bash a fork costs tens
# of milliseconds, so a 1,000-line commit spent minutes in the hook and people
# started reaching for --no-verify — which protects nothing. The scan now runs
# ONE awk pass that tags each added line with its file, then ONE `grep` per
# pattern over that stream. The detection patterns are byte-identical to the
# originals and `grep -E` (not awk) still does the matching, so the hook cannot
# silently weaken as a side effect of the rewrite.
#
# NOTE: a hook only protects NEW commits. It does NOT scrub history that is
# already pushed. Past leaks must be removed with git-filter-repo / BFG and
# the associated keys rotated.
# ============================================================================
set -u

RED=$'\033[31m'
BOLD=$'\033[1m'
NC=$'\033[0m'
FAILED=0

# ---- 1) Banned file names (staged adds / copies / modifications) ----------
# Env files (unless *.example), private-key material, credential JSONs.
BANNED_NAMES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env($|\.)|\.pem$|\.p12$|\.pfx$|\.key$|\.keystore$|\.jks$|\.p8$|serviceAccount[^/]*\.json$|credentials?[^/]*\.json$|google-services\.json$|GoogleService-Info\.plist$' | grep -vE '\.example($|\.)' || true)

if [ -n "$BANNED_NAMES" ]; then
    FAILED=1
    echo "${RED}${BOLD}Blocked:${NC} commit adds/modifies files that look like secrets:" >&2
    echo "$BANNED_NAMES" | sed 's/^/    - /' >&2
    echo "    If this is intentional (e.g. a *.example template), rename the file" >&2
    echo "    so it ends in .example or force with: git commit --no-verify" >&2
fi

# ---- 2) Secret patterns in staged content ----------------------------------
# High-confidence token shapes (provider-prefixed keys, private keys, webhooks).
STRONG='(AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|(sk|rk|pk)_(live|test)_[0-9A-Za-z]{16,}|whsec_[A-Za-z0-9+/=_-]{12,}|SG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}|npm_[A-Za-z0-9]{30,}|shp(at|ss|ca)_[a-fA-F0-9]{20,}|hooks\.slack\.com/services/T[0-9A-Z]+/B[0-9A-Z]+|discord(app)?\.com/api/webhooks/[0-9]+/|-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----|npg_[A-Za-z0-9]{16,})'

# Secret-looking variable assignments, e.g. CLERK_SECRET_KEY=sk_test_...
KEYWORDS_RE='(API[_-]?KEY|ACCESS[_-]?KEY|PRIVATE[_-]?KEY|SECRET|TOKEN|PASSWORD|PASSWD|DATABASE_URL|REDIS_URL|CLERK|WEBHOOK|SIGNING|JWT|SESSION|SUPABASE|STRIPE|OPENAI|ANTHROPIC|TWILIO|SENDGRID|MAPBOX|ALGOLIA)'
# Values that are clearly placeholders or references to other variables.
PLACEHOLDER='your_|xxxx|example|changeme|dummy|placeholder|<|>|process\.env|\$\{'

mask() {
    local m=$1
    if [ ${#m} -le 12 ]; then echo "$m"; else echo "${m:0:6}...${m: -4}"; fi
}

# The staged diff, captured once. `-U0` keeps it to added/removed lines only,
# and `--no-color` keeps the patterns from having to cope with ANSI escapes.
DIFF_FILE=$(mktemp) || { echo "${RED}${BOLD}Blocked:${NC} cannot create a temp file for the scan." >&2; exit 1; }
trap 'rm -f "$DIFF_FILE"' EXIT
git diff --cached --no-color -U0 > "$DIFF_FILE" || true

# Added lines, tagged with the file they came from and their diff line number:
#     <path>\t<lineno>\t<content>
# The prefix cannot create a false positive: a path that matches a token shape
# (e.g. a file literally named `ghp_...`) is itself a leak.
#
# Two streams, because the assignment pattern has to be matched against the
# CONTENT (it is `^`-anchored, so the tag prefix would break it) and running a
# `grep` per line is exactly the cost this rewrite removes. The assignment
# pre-filter below is deliberately a SUPERSET of the real test (it ignores the
# optional quote, which the in-loop check still enforces) — a pre-filter only
# has to be cheap, never clever, and every candidate is re-checked.
staged_added_lines() {
    awk '
        /^diff --git / {
            f = $0
            sub(/^diff --git a\//, "", f)
            sub(/ b\/.*$/, "", f)
            next
        }
        /^\+\+\+ / { next }
        /^\+/ { print f "\t" NR "\t" substr($0, 2) }
    ' "$DIFF_FILE"
}

staged_assignment_lines() {
    awk '
        /^diff --git / {
            f = $0
            sub(/^diff --git a\//, "", f)
            sub(/ b\/.*$/, "", f)
            next
        }
        /^\+\+\+ / { next }
        /^\+/ {
            c = substr($0, 2)
            if (c ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*[^[:space:]]{16,}/) print f "\t" NR "\t" c
        }
    ' "$DIFF_FILE"
}

# ── High-confidence token shapes ──
while IFS=$'\t' read -r file lineno content; do
    [ -z "${content:-}" ] && continue
    m=$(printf '%s\n' "$content" | grep -oE "$STRONG" | head -1 || true)
    [ -z "$m" ] && continue
    FAILED=1
    echo "${RED}${BOLD}Blocked:${NC} possible secret in ${file}:" >&2
    echo "    $(mask "$m")  (line ${lineno}: $(printf '%s' "$content" | cut -c1-160))" >&2
done <<< "$(staged_added_lines | grep -E "$STRONG" || true)"

# ── KEY = long-value assignments ──
while IFS=$'\t' read -r file lineno content; do
    [ -z "${content:-}" ] && continue
    if ! printf '%s\n' "$content" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*["'"'"']?[^[:space:]"'"'"']{16,}'; then
        continue
    fi
    key=$(printf '%s\n' "$content" | sed -E 's/^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*).*/\1/')
    val=$(printf '%s\n' "$content" | sed -E 's/^[^=]*=[[:space:]]*["'"'"']?([^[:space:]"'"'"']*).*/\1/')
    shopt -s nocasematch
    if [[ "$key" =~ $KEYWORDS_RE ]] && ! [[ "$key" =~ ^(NEXT_PUBLIC_|VITE_|REACT_APP_|EXPO_PUBLIC_) ]] && ! [[ "$val" =~ $PLACEHOLDER ]] && ! [[ "$val" =~ \$ ]] && [ ${#val} -ge 16 ]; then
        FAILED=1
        echo "${RED}${BOLD}Blocked:${NC} possible secret value for $key in ${file}:" >&2
        echo "    $(mask "$val")  (line ${lineno}: $(printf '%s' "$content" | cut -c1-160))" >&2
    fi
    shopt -u nocasematch
done <<< "$(staged_assignment_lines || true)"

if [ "$FAILED" -ne 0 ]; then
    echo >&2
    echo "${BOLD}Commit aborted.${NC} Remove the secrets (move them to an untracked" >&2
    echo ".env / your secrets manager) and stage the fixed files again." >&2
    echo "Only bypass with: git commit --no-verify" >&2
    exit 1
fi

exit 0
