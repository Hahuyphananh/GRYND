# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
realtime-server/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# clerk configuration (can include secrets)
/.clerk/

.vercel
.env*.local

# Sentry Config File
.env.sentry-build-plugin
.env.local

# Windows shell quirk: `> NUL` redirection sometimes creates a literal file named NUL
/NUL

# Numeric-prefixed stray files at the project root (typically from
# accidental `curl -o <status_code>` smoke tests; the trailing bytes were
# original UTF-8 emoji that were mangled to replacement characters).
# Prevents re-creation. Match anything starting with a digit at the root.
/[0-9]*
.env*
.aider*

# --- Secret hygiene (from secret audit) ---
# Real env files at any depth are banned; only *.example placeholders may be
# committed. realtime-server/.env was tracked in the past -> remove it with:
#   git rm --cached realtime-server/.env
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Key material / credential files (public *.pub keys are fine to share)
**/*.pem
**/*.p12
**/*.pfx
**/*.key
**/*.keystore
**/*.jks
**/*.p8
**/serviceAccount*.json
**/credentials*.json
**/google-services.json
**/GoogleService-Info.plist

# Load-test session tokens (one per VU)
load-test/tokens.csv

# Database backups (contain real user data — never commit them)
/backups/

# --- QA run artifacts ---
# The qa/*-check.mjs scripts write Playwright captures into qa/reports/ on
# every run. They are diagnostics, not source: committing them left ~117
# screenshots of drifting UI in the repo, and the QA agent workflow's
# `git add -A` swept a fresh set in each time. Ignored by extension rather
# than by directory so the machine-readable reports in the same folder stay
# tracked — .github/qa-agent.mjs reads qa/reports/qa-report.json.
qa/reports/**/*.png
qa/reports/**/*.jpg
qa/reports/**/*.jpeg
qa/reports/**/*.webp
qa/reports/**/*.gif

# Added by ggshield
.cache_ggshield
