<?xml version="1.0" encoding="utf-8"?>
<!-- GRYND adaptive-icon background layer (Phase 7).

     The stock Android Studio/Capacitor template shipped a teal 108dp grid here.
     It is not referenced by mipmap-anydpi-v26/ic_launcher.xml (which uses
     @color/ic_launcher_background), but the resource name is kept so anything
     resolving @drawable/ic_launcher_background still gets the brand surface
     instead of template art. Keep this colour in sync with
     values/ic_launcher_background.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#030817"
        android:pathData="M0,0h108v108h-108z" />
</vector>
