# realtime-server — environment template
#
# Copy to `.env` for local development:  cp .env.example .env
# Deployed on RENDER. Every value here is entered in the Render dashboard (or
# the `sync: false` entries in the repository-root render.yaml) — never committed.
#
# This file must stay VALUE-FREE. No real keys, tokens, hashes or connection
# strings. tests/speed-typing-deployment.test.mjs enforces that.

# ── Local development ────────────────────────────────────────────────────

# Port the Socket.IO service listens on locally.
# In production Render also assigns PORT; see render.yaml for the caveat.
PORT=3001

# The web origins allowed to open a socket here (CORS, comma-separated).
# Include the production Vercel domain, plus any preview domain you use.
# The service REFUSES TO START if this resolves to an empty list.
CLIENT_URL=http://localhost:3000

# ── Required in production ──────────────────────────────────────────────

# Clerk secret key. Used to verify the Clerk session token every socket
# presents in `handshake.auth.token`. Without it, no socket can connect.
# Needs to be set HERE (Render); the browser never receives it.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Shared secret authenticating the Vercel backend's server-to-server `/emit`
# calls. MUST be the SAME value on Vercel and on Render — if they differ every
# realtime push is rejected with 401 while the app still looks healthy.
REALTIME_INTERNAL_SECRET=your_shared_internal_secret_here

# Base URL of the deployed Next.js app (Vercel), used for every callback this
# service makes: the disconnect forfeits, admin socket verification, crash-arena
# cleanup and quick-queue assignment.
#
# The code falls back to http://localhost:3000. That default is correct for
# local development and WRONG in production: an unset value here means every
# callback is sent to a localhost that does not exist, silently.
NEXTJS_INTERNAL_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────

# Set to 1 to log every realtime event instead of throttling the hot paths.
# REALTIME_DEBUG=1
