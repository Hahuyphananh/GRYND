{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "node16",
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/app/layout.tsx",
    "src/middleware.ts",
    "src/app/api/uno/initialize-vs-ai/route.js",
    "src/app/api/create-2048-game/route.js",
    "src/app/api/keno/start/route.js",
    "src/app/api/poker/join-game/route.js",
    "src/app/api/poker/create-game/route.js",
    "src/app/casino/chess-game/[gameId]/page.jsx",
    "src/app/scripts/resolveBets.js",
    "src/app/api/tanks/start-match/route.js",
    "src/app/api/chess/end-game/route.js",
    ".next/dev/types/**/*.ts",
    "src/app/api/get-user/route.js",
    "src/app/api/tanks/leave-match/route.js"
, "public/manifest.son"  ],
  // open-next.config.ts is Cloudflare/OpenNext BUILD TOOLING, not app code. It is
  // compiled by the OpenNext CLI with esbuild (ESM), but `next build` would also
  // type-check it through the "**/*.ts" include above. Because this project's
  // tsconfig is `module: node16` (CommonJS) and @opennextjs/cloudflare is
  // ESM-only, that produces TS1479. Excluding it keeps `next build` — and
  // therefore the existing Vercel deploy — type-checking exactly the app it did
  // before this migration.
  "exclude": ["node_modules", "my-video", "video-pipeline", "social-agent", "open-next.config.ts", "cloudflare-worker.ts"]
}
