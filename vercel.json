{
  "crons": [
    {
      "path": "/api/jobs/weekly-reset",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/jobs/retention",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/jobs/daily-reset",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/jobs/rank-snapshots",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/jobs/battleship-timeouts",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/audience-snapshot",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/jobs/pro-weekly-recap",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/jobs/solitaire-ghost-pool",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/jobs/solitaire-inactivity",
      "schedule": "*/5 * * * *"
    }
  ],
  "services": {
    "casino-realtime-server": {
      "root": "realtime-server",
      "entrypoint": "server.js",
      "buildCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "casino-realtime-server"
      }
    }
  ]
}
